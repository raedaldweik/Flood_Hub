# ─────────────────────────────────────────────────────────────────────────────
#  PROJECT SADD — environment variables
#  Local: copy to `.env` (backend + compose) and `frontend/.env.local` (Next.js).
#  Railway: see docs/DEPLOY_RAILWAY.md — the app service needs only DATABASE_URL
#  (as a ${{sadd-db.*}} reference), SEED_ON_STARTUP and the Maps key.
#  EVERY key is optional: the app degrades gracefully when one is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local (docker compose). On Railway use the reference form instead:
#   postgresql://${{sadd-db.POSTGRES_USER}}:${{sadd-db.POSTGRES_PASSWORD}}@${{sadd-db.RAILWAY_PRIVATE_DOMAIN}}:5432/${{sadd-db.POSTGRES_DB}}
DATABASE_URL=postgresql://sadd:sadd@localhost:5432/sadd
# Credentials for the Postgres container (compose locally; the `sadd-db` service on Railway).
POSTGRES_USER=sadd
POSTGRES_PASSWORD=sadd
POSTGRES_DB=sadd
POSTGRES_PORT=5432

# ── Seeding + replay ────────────────────────────────────────────────────────
# Seed automatically at startup when the database is empty (the Railway image relies on this).
SEED_ON_STARTUP=true
# Set to 1 to skip Open-Meteo at seed time and use the bundled fallback storm curve.
SEED_FORCE_FALLBACK=0
# Replay window for the April-2024 event (Asia/Qatar local dates, inclusive) and tick size.
REPLAY_START_DATE=2024-04-15
REPLAY_END_DATE=2024-04-17
REPLAY_TICK_MINUTES=10

# ── Google Maps Platform (Photorealistic 3D) — §12.1 ────────────────────────
# Enable BOTH "Maps JavaScript API" and "Map Tiles API", restrict the key to your
# origins (http://localhost:3000/* and https://<app>.up.railway.app/*).
# Inlined at BUILD time. Missing → dark 2D MapLibre fallback with a banner.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map engine for the Command Center: "vector" (default) = Google's dark vector map with 3D buildings
# and the risk-lit towers (three.js); "3d" = photorealistic Map3DElement (imagery on terrain).
NEXT_PUBLIC_MAP_ENGINE=vector
# Optional Map ID for the vector engine (Cloud Console → Map Management). Empty = Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ── Gemini API (Rafid agent + embeddings, Phase 3) — §12.2 ──────────────────
# From Google AI Studio. Missing → Rafid answers with a static offline notice.
# Rafid (ADK agent) — required for the agent; embeddings for protocol RAG use the same key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Open-Meteo — NO KEY (§12.3) ─────────────────────────────────────────────
OPEN_METEO_LAT=25.2854
OPEN_METEO_LNG=51.5310

# ── Custom flood-forecasting-mcp (Phase 3) — §9 ─────────────────────────────
# simulated | live   (live requires Google Flood Forecasting API pilot access)
FLOOD_MCP_BACKEND=simulated
FLOOD_FORECASTING_API_KEY=

# ── Local-only knobs (leave unset on Railway) ───────────────────────────────
# Backend port for `make backend`. On Railway set PORT=8000 on the app service so it matches the domain.
BACKEND_PORT=8000
# Origins allowed to call the API from another origin (only `next dev` needs this).
CORS_ORIGINS=http://localhost:3000
# Browser → API base. Leave EMPTY: `next dev` on :3000 auto-targets :8000, and the
# production image serves UI + API from one origin. Set only for unusual setups.
NEXT_PUBLIC_API_BASE=
# Serve a static export from FastAPI (the production image sets this to /app/frontend/out).
FRONTEND_DIST=
# MCP Toolbox for Databases — started by backend/start.sh in the container; `make toolbox` locally.
TOOLBOX_URL=http://127.0.0.1:5000

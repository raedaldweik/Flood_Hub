# ─────────────────────────────────────────────────────────────────────────────
#  PROJECT SADD — environment variables
#  Copy to `.env` (backend + compose) and `frontend/.env.local` (Next.js).
#  EVERY key is optional: the app degrades gracefully when one is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (docker-compose defaults; change only if you run your own PG) ──
POSTGRES_USER=sadd
POSTGRES_PASSWORD=sadd
POSTGRES_DB=sadd
POSTGRES_PORT=5432
# Full DSN used by the FastAPI backend and the seed script.
DATABASE_URL=postgresql://sadd:sadd@localhost:5432/sadd

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Replay window for the April-2024 event (Asia/Qatar local dates, inclusive).
REPLAY_START_DATE=2024-04-15
REPLAY_END_DATE=2024-04-17
# Tick resolution of the precomputed replay timeline, in minutes.
REPLAY_TICK_MINUTES=10
# Set to 1 to skip Open-Meteo at seed time and use the bundled fallback CSV.
SEED_FORCE_FALLBACK=0
# Seed automatically at startup when the database is empty (what the Railway image relies on).
SEED_ON_STARTUP=true
# Serve the Next.js static export from FastAPI (production image sets this). Empty = API only.
FRONTEND_DIST=

# ── Google Maps Platform (Photorealistic 3D) — §12.1 ────────────────────────
# Enable BOTH "Maps JavaScript API" and "Map Tiles API" on the GCP project,
# then restrict the key to http://localhost:3000/* referrers.
# Missing → the frontend renders a dark 2D MapLibre fallback with a banner.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Gemini API (Rafid agent + embeddings) — §12.2 ───────────────────────────
# From Google AI Studio. Missing → Rafid answers with a static offline notice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Open-Meteo — NO KEY (§12.3) ─────────────────────────────────────────────
# Doha coordinates used for historical replay + live weather.
OPEN_METEO_LAT=25.2854
OPEN_METEO_LNG=51.5310

# ── Custom flood-forecasting-mcp (Phase 3) — §9 ─────────────────────────────
# simulated | live   (live requires Google Flood Forecasting API pilot access)
FLOOD_MCP_BACKEND=simulated
FLOOD_FORECASTING_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────
# Where the browser reaches the FastAPI backend. Local dev: http://localhost:8000.
# Production image: leave EMPTY — the static export is served by FastAPI on the same origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000
